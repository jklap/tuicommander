+// Temporary 2040 observer; removed before the evidence commit.
+fn trace_2040(event: &str, session: &str, details: serde_json::Value) {
+    static ENABLED: LazyLock<bool> = LazyLock::new(|| std::env::var_os("TUIC_2040_TRACE").is_some());
+    if !*ENABLED { return; }
+    let at_us = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_micros();
+    eprintln!("TUIC2040 {}", serde_json::json!({"event": event, "session": session, "at_us": at_us, "details": details}));
+}
+fn trace_2040_screen(vt: &tuic_terminal::vt_log::VtLogBuffer) -> serde_json::Value {
+    serde_json::json!({"screen": vt.read_rows_in_range(vt.grid_history_size(), vt.grid_history_size()+vt.grid_screen_lines()-1), "origin": vt.grid_screen_origin(), "history": vt.grid_history_size(), "total": vt.grid_total_lines(), "rows": vt.grid_screen_lines(), "columns": vt.grid_columns()})
+}

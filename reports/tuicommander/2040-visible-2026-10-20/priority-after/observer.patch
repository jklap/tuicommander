+// Temporary bounded input-priority measurement observer; remove before committing source.
+fn trace_2040(event: &str, session: &str, mut details: serde_json::Value) {
+    static ENABLED: LazyLock<bool> = LazyLock::new(|| std::env::var_os("TUIC_2040_TRACE").is_some());
+    static CLOCK: LazyLock<(std::time::Instant, u128)> = LazyLock::new(|| (std::time::Instant::now(), std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_micros()));
+    if !*ENABLED { return; }
+    let mono_us = CLOCK.0.elapsed().as_micros();
+    for field in ["bytes", "frame_bytes", "processed_bytes"] {
+        if let Some(value) = details.as_object_mut().and_then(|d| d.remove(field)) {
+            let bytes: Vec<u8> = value.as_array().unwrap().iter().map(|v| v.as_u64().unwrap() as u8).collect();
+            let hash = bytes.iter().fold(2166136261u32, |hash, byte| (hash ^ *byte as u32).wrapping_mul(16777619));
+            let keys: String = if event == "pty-read" || field == "processed_bytes" {
+                String::from_utf8_lossy(&bytes).chars().filter(|ch| ('①'..='⑮').contains(ch)).collect()
+            } else {
+                let mut keys = String::new();
+                let mut at = 26usize;
+                if bytes.len() >= at {
+                    let rows = u16::from_le_bytes([bytes[0], bytes[1]]);
+                    for _ in 0..rows {
+                        if at+4 > bytes.len() { break; }
+                        let flagged = u16::from_le_bytes([bytes[at+2], bytes[at+3]]);
+                        at += 4;
+                        if flagged & 0x4000 != 0 { at += 2; }
+                        for _ in 0..(flagged & 0x3fff) {
+                            if at+11 > bytes.len() { break; }
+                            if let Some(ch) = char::from_u32(u32::from_le_bytes(bytes[at..at+4].try_into().unwrap()))
+                                && ('①'..='⑮').contains(&ch) { keys.push(ch); }
+                            at += 11;
+                        }
+                    }
+                }
+                keys
+            };
+            details[field] = serde_json::json!({"len": bytes.len(), "fnv1a32": hash, "keys": keys});
+        }
+    }
+    if let Some(object) = details.as_object_mut() { object.remove("tail"); }
+    eprintln!("TUIC2040 {}", serde_json::json!({"event":event,"session":session,"mono_us":mono_us,"anchor_epoch_us":CLOCK.1,"details":details}));
+}
+fn trace_2040_screen(vt: &tuic_terminal::vt_log::VtLogBuffer) -> serde_json::Value {
+    serde_json::json!({"screen": vt.read_rows_in_range(vt.grid_history_size(), vt.grid_history_size()+vt.grid_screen_lines()-1).into_iter().map(|row| row.chars().filter(|ch| ('①'..='⑮').contains(ch)).collect::<String>()).collect::<Vec<_>>(), "origin": vt.grid_screen_origin(), "history": vt.grid_history_size(), "total": vt.grid_total_lines(), "rows": vt.grid_screen_lines(), "columns": vt.grid_columns()})
+}

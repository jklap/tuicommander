{"step":"respond","to":"init","result_file":"ego-initialize.json"}
{"step":"expect","method":"session/new","params":{"mcpServers":[{"name":"tuicommander","command":"/opt/tuic/tuic-bridge","args":[],"env":[]}]},"capture":"new"}
{"step":"respond","to":"new","result":{"sessionId":"01932d5e-0000-7000-8000-0000000000aa","configOptions":[]}}
{"step":"expect","method":"session/load","params":{"sessionId":"01932d5e-0000-7000-8000-0000000000bb","mcpServers":[{"name":"tuicommander","command":"/opt/tuic/tuic-bridge","args":[],"env":[]}]},"capture":"load"}
{"step":"respond","to":"load","result":{"configOptions":[]}}
{"step":"await_stdin_eof"}
